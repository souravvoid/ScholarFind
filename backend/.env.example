# Django
# development (default) or production
DJANGO_ENV=development
# Required when DJANGO_ENV=production. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=change-me-in-development
DJANGO_DEBUG=True
DJANGO_LOG_LEVEL=INFO
ALLOWED_HOSTS=127.0.0.1,localhost
CORS_ALLOWED_ORIGINS=http://localhost:3000

# PostgreSQL (or use DATABASE_URL)
DATABASE_URL=
POSTGRES_DB=scholarfind_django
POSTGRES_USER=scholarfind
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Google OAuth (leave blank to disable the OAuth endpoints with HTTP 503)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/auth/google/callback/

# DRF throttling rates (optional overrides)
DRF_ANON_RATE=120/min
DRF_USER_RATE=1000/hour
DRF_EVALUATE_RATE=60/min

# --- Production example (DJANGO_ENV=production) ---
# DJANGO_ENV=production
# DJANGO_DEBUG=False
# DJANGO_SECRET_KEY=<long-random-value>
# ALLOWED_HOSTS=api.example.com
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
# POSTGRES_PASSWORD=<strong-password>
