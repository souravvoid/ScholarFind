rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Global default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // User Profile sub-document
    match /users/{userId}/profile/{docId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow list: if isOwner(userId);
      allow create, update: if isOwner(userId) 
        && isValidId(userId)
        && request.resource.data.uid == userId;
      allow delete: if isOwner(userId);
    }

    // User Saved Scholarships & Tracker
    match /users/{userId}/saved_scholarships/{scholarshipId} {
      allow get: if isOwner(userId) && isValidId(userId) && isValidId(scholarshipId);
      allow list: if isOwner(userId);
      allow create, update: if isOwner(userId) 
        && isValidId(userId) 
        && isValidId(scholarshipId)
        && request.resource.data.userId == userId;
      allow delete: if isOwner(userId) && isValidId(scholarshipId);
    }

    // Public Scholarships Catalogue (Read-only for public, writable for synchronization)
    match /scholarships/{scholarshipId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Public Scholarship Sources & Audit Registry
    match /scholarship_sources/{sourceId} {
      allow get, list: if true;
      allow create, update: if true;
      allow delete: if false;
    }

    // Public Ingestion provenance and audit records
    match /ingestion_logs/{logId} {
      allow get, list: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // Connection testing doc
    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
