{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Student academic profile and credentials used for deterministic eligibility evaluation.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "photoURL": { "type": "string" },
        "citizenship": { "type": "string" },
        "residenceCountry": { "type": "string" },
        "educationLevel": { "type": "string" },
        "institution": { "type": "string" },
        "gradingScale": { "type": "string" },
        "gpa": { "type": "number" },
        "maxGpa": { "type": "number" },
        "graduationYear": { "type": "string" },
        "primaryField": { "type": "string" },
        "facultyTags": { "type": "array" },
        "researchKeywords": { "type": "array" },
        "targetDegrees": { "type": "array" },
        "targetRegions": { "type": "array" },
        "targetCountries": { "type": "array" },
        "deliveryModality": { "type": "string" },
        "intendedStartTerm": { "type": "string" },
        "workExperienceYears": { "type": "number" },
        "englishTestType": { "type": "string" },
        "englishScore": { "type": "string" },
        "hasEnglishMediumInstruction": { "type": "boolean" },
        "updatedAt": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email"]
    },
    "SavedScholarship": {
      "title": "SavedScholarship",
      "description": "Scholarship saved by a student with tracking status and personal checklist.",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "scholarshipId": { "type": "string" },
        "scholarshipTitle": { "type": "string" },
        "provider": { "type": "string" },
        "destination": { "type": "string" },
        "awardValue": { "type": "string" },
        "deadline": { "type": "string" },
        "status": { "type": "string", "enum": ["interested", "preparing", "ready", "applied"] },
        "completedDocs": { "type": "array" },
        "notes": { "type": "string" },
        "reminderDate": { "type": "string" },
        "savedAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "scholarshipId", "status"]
    },
    "IngestionLog": {
      "title": "IngestionLog",
      "description": "Provenance and health logs for scholarship data sources.",
      "type": "object",
      "properties": {
        "sourceId": { "type": "string" },
        "sourceName": { "type": "string" },
        "status": { "type": "string" },
        "itemsIngested": { "type": "number" },
        "lastCheckedAt": { "type": "string" },
        "provenanceUrl": { "type": "string" }
      },
      "required": ["sourceId", "status"]
    },
    "Scholarship": {
      "title": "Scholarship",
      "description": "Verified scholarship record from official institutional and government endowments.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "slug": { "type": "string" },
        "title": { "type": "string" },
        "providerName": { "type": "string" },
        "providerCategory": { "type": "string" },
        "heroImage": { "type": "string" },
        "destinationCountries": { "type": "array" },
        "destinationFlag": { "type": "string" },
        "hostInstitutions": { "type": "array" },
        "studyLevels": { "type": "array" },
        "fieldsOfStudy": { "type": "array" },
        "totalAwardValue": { "type": "string" },
        "awardDetails": { "type": "string" },
        "estimatedUSDValue": { "type": "number" },
        "applicationDeadline": { "type": "string" },
        "daysRemaining": { "type": "number" },
        "academicYear": { "type": "string" },
        "lastVerified": { "type": "string" },
        "officialSourceUrl": { "type": "string" },
        "officialApplicationUrl": { "type": "string" },
        "sourceDomain": { "type": "string" },
        "requiredDocuments": { "type": "array" },
        "applicationInstructions": { "type": "array" },
        "overview": { "type": "string" },
        "criteria": { "type": "array" },
        "provenance": { "type": "object" }
      },
      "required": ["id", "title", "providerName", "officialSourceUrl", "officialApplicationUrl"]
    },
    "ScholarshipSource": {
      "title": "ScholarshipSource",
      "description": "Approved source adapter registry entry with legal provenance and sync statistics.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "originAgency": { "type": "string" },
        "country": { "type": "string" },
        "flag": { "type": "string" },
        "adapterModule": { "type": "string" },
        "accessMethod": { "type": "string" },
        "status": { "type": "string" },
        "scholarshipCount": { "type": "number" },
        "lastIngested": { "type": "string" },
        "provenanceUrl": { "type": "string" },
        "auditPrinciples": { "type": "string" }
      },
      "required": ["id", "name", "originAgency", "country", "provenanceUrl"]
    }
  },
  "firestore": {
    "/users/{userId}/profile/data": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "Private profile of the authenticated student."
    },
    "/users/{userId}/saved_scholarships/{scholarshipId}": {
      "schema": { "$ref": "#/entities/SavedScholarship" },
      "description": "Scholarships saved and tracked by the student."
    },
    "/scholarships/{scholarshipId}": {
      "schema": { "$ref": "#/entities/Scholarship" },
      "description": "Verified scholarship listing catalog."
    },
    "/scholarship_sources/{sourceId}": {
      "schema": { "$ref": "#/entities/ScholarshipSource" },
      "description": "Authoritative registry of official scholarship sources."
    },
    "/ingestion_logs/{logId}": {
      "schema": { "$ref": "#/entities/IngestionLog" },
      "description": "Audit and provenance records of scholarship collection sources."
    }
  }
}
